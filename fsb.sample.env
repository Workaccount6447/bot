# ===== fsb-bot (Telegram bot / frontend) =====
API_ID=
API_HASH=
BOT_TOKEN=

# Owner's storage channel. Bot must be ADMIN here. Files of users who did NOT
# connect their own channel are stored here and auto-deleted (see below).
LOG_CHANNEL=

# Same MongoDB as fsb-stream (required)
DATABASE_URL=
# Same secret as fsb-stream. If empty, BOT_TOKEN is used.
HASH_SECRET=
HASH_LENGTH=16

# ---- Traffic divider: public URL(s) of fsb-stream instance(s), no trailing slash ----
# Each generated link is assigned to one of these, spread evenly (stable per link).
# Every instance must use the SAME DATABASE_URL, HASH_SECRET, BOT_TOKEN, LOG_CHANNEL.
STREAM_HOST=https://stream1.example.com
# STREAM_HOST2=https://stream2.example.com
# STREAM_HOST3=https://stream3.example.com
# or a comma list instead:  STREAM_HOSTS=https://stream1.example.com,https://stream2.example.com

# ---- Expiry for files in the OWNER channel ----------------------------------
# Hours until the file is deleted from LOG_CHANNEL, its DB record removed and
# its links stop working. 0 = never expire. Decimals allowed (0.5 = 30 min).
FILE_EXPIRY_HOURS=6
# How often the cleaner checks (seconds)
EXPIRY_CHECK_SEC=60

# ---- Multi-link mode (/multi ... /done) -------------------------------------
MAX_BATCH=25
BATCH_TIMEOUT_MINS=15

# ---- Optional -----------------------------------------------------------------
OWNER_ID=
ULOG_CHANNEL=
UPDATES_CHANNEL=
BOT_NAME=File to Link
# ALLOWED_USERS=12345,67890
PORT=8080
DEV=false
